# Copy to terraform.tfvars (gitignored) before planning.
# Do NOT put real secrets here that you would commit; DB/JWT secrets are generated by Terraform.

project_name = "paylink"
aws_region   = "us-east-1"

# Diagram CIDRs (defaults already match; override only if needed)
# vpc_cidr            = "10.42.0.0/16"
# public_subnet_cidrs = ["10.42.0.0/24", "10.42.1.0/24"]
# app_subnet_cidrs    = ["10.42.10.0/24", "10.42.11.0/24"]
# db_subnet_cidrs     = ["10.42.20.0/24", "10.42.21.0/24"]

frontend_desired_count = 2
backend_desired_count  = 2
backend_min_capacity   = 2
backend_max_capacity   = 4

# Cost knobs for class credits:
db_instance_class = "db.t4g.micro"
db_multi_az       = true # set false for the cheaper lab (no RDS failover)
log_retention_days = 7

public_demo_enabled = true

# Keep false for foundation staging, then set true after DB bootstrap succeeds.
enable_app_services = false
# Set a fresh Git commit tag for each release.
image_tag = "candidate"
