<mxfile host="app.diagrams.net">
  <diagram name="PayLink ER Model" id="paylink-er">
    <mxGraphModel dx="2004" dy="877" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;username : text [UNIQUE]&lt;br&gt;email : text [UNIQUE]&lt;br&gt;phone : text [UNIQUE, nullable]&lt;br&gt;full_name : text&lt;br&gt;password_hash : text (Argon2id)&lt;br&gt;created_at : timestamptz" vertex="1">
          <mxGeometry height="233" width="335" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="account_holders" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" value="&lt;b&gt;ACCOUNT_HOLDERS&lt;/b&gt;&lt;hr&gt;user_id : uuid [PK, FK → users]&lt;br&gt;account_id : uuid [PK, FK → accounts]&lt;br&gt;joined_at : timestamptz" vertex="1">
          <mxGeometry height="137" width="335" x="420" y="80" as="geometry" />
        </mxCell>
        <mxCell id="banks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" value="&lt;b&gt;BANKS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;routing_number : text [UNIQUE]&lt;br&gt;name : text" vertex="1">
          <mxGeometry height="137" width="335" x="820" y="80" as="geometry" />
        </mxCell>
        <mxCell id="bank_accounts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" value="&lt;b&gt;BANK_ACCOUNTS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;bank_id : uuid [FK → banks]&lt;br&gt;account_number : text&lt;br&gt;account_type : checking | savings&lt;br&gt;label : text&lt;br&gt;balance_cents : bigint ≥ 0&lt;br&gt;opening_balance_cents : bigint ≥ 0&lt;br&gt;active : boolean&lt;br&gt;created_at : timestamptz&lt;br&gt;UNIQUE(bank_id, account_number)" vertex="1">
          <mxGeometry height="305" width="335" x="800" y="330" as="geometry" />
        </mxCell>
        <mxCell id="transfers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" value="&lt;b&gt;TRANSFERS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;initiated_by : uuid [FK → users]&lt;br&gt;source_account_id : uuid [FK → accounts]&lt;br&gt;destination_account_id : uuid [FK → accounts]&lt;br&gt;amount_cents : bigint &amp;gt; 0&lt;br&gt;memo : text (≤ 140)&lt;br&gt;idempotency_key : uuid&lt;br&gt;created_at : timestamptz&lt;br&gt;UNIQUE(initiated_by, idempotency_key)" vertex="1">
          <mxGeometry height="281" width="335" x="190" y="410" as="geometry" />
        </mxCell>
        <mxCell id="edge0" edge="1" parent="1" source="users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="account_holders" value="1 : 0..N · ownership">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge1" edge="1" parent="1" source="bank_accounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="account_holders" value="1 : 1..N · holders*">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" edge="1" parent="1" source="banks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="bank_accounts" value="1 : 0..N · bank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" edge="1" parent="1" source="users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="transfers" value="1 : 0..N · initiator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" edge="1" parent="1" source="bank_accounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="transfers" value="1 : 0..N · source">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge5" edge="1" parent="1" source="bank_accounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" target="transfers" value="1 : 0..N · destination">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;whiteSpace=wrap;html=0;align=left;fontSize=13;fontColor=#617A92;" value="PayLink · CS 5600 · Logical ER model&#xa;USD only · Five base relations&#xa;* At least one holder is guaranteed by open_account; no deferred SQL assertion.&#xa;Solid relationships are FKs. Source ownership is checked by the transfer function." vertex="1">
          <mxGeometry height="100" width="1130" x="40" y="770" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
