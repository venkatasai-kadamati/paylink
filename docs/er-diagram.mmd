erDiagram
 USERS ||--o{ ACCOUNT_HOLDERS : owns
 BANK_ACCOUNTS ||--|{ ACCOUNT_HOLDERS : has_owners
 BANKS ||--o{ BANK_ACCOUNTS : maintains
 USERS ||--o{ TRANSFERS : initiates
 BANK_ACCOUNTS ||--o{ TRANSFERS : sends_from
 BANK_ACCOUNTS ||--o{ TRANSFERS : receives_into
 BANK_ACCOUNTS ||--o{ ACCOUNT_INVITATIONS : offered_for
 USERS ||--o{ ACCOUNT_INVITATIONS : invites
 USERS ||--o{ ACCOUNT_INVITATIONS : invited
 TRANSFERS ||--|{ TRANSFER_POSTINGS : posts_two_legs
 BANK_ACCOUNTS ||--o{ TRANSFER_POSTINGS : journaled_in
 TRANSFERS ||--o| TRANSFER_REVERSALS : original
 TRANSFERS ||--o| TRANSFER_REVERSALS : compensation
 USERS {
  uuid id PK
  text username UK
  text email UK
  text phone UK "optional"
  text full_name
  text password_hash
  timestamptz created_at
 }
 BANKS {
  uuid id PK
  text routing_number UK
  text name
 }
 BANK_ACCOUNTS {
  uuid id PK
  uuid bank_id FK
  text account_number "unique with bank_id"
  text account_type
  text label
  bigint balance_cents
  bigint opening_balance_cents
  boolean active
  timestamptz created_at
 }
 ACCOUNT_HOLDERS {
  uuid user_id PK,FK
  uuid account_id PK,FK
  timestamptz joined_at
 }
 TRANSFERS {
  uuid id PK
  uuid initiated_by FK "unique with idempotency_key"
  uuid source_account_id FK
  uuid destination_account_id FK
  bigint amount_cents
  text memo
  uuid idempotency_key
  timestamptz created_at
 }
 ACCOUNT_INVITATIONS {
  uuid id PK
  uuid account_id FK
  uuid inviter_id FK
  uuid invitee_id FK
  timestamptz created_at
  timestamptz expires_at
  text decision "optional"
  timestamptz decided_at "optional"
 }
 TRANSFER_POSTINGS {
  uuid transfer_id PK,FK
  text side PK
  uuid account_id FK "unique with transfer_id"
  bigint delta_cents
 }
 TRANSFER_REVERSALS {
  uuid original_transfer_id PK,FK
  uuid reversing_transfer_id UK,FK
  text reason
 }
